# =====================================================================
# 体检胸片所见草稿系统 — 凭据位（全部从环境变量读取，禁止硬编码）
#
# 用法：cp .env.example .env   然后填入真实凭据。
# .env 已在 .gitignore 中排除；提交到 GitHub 的永远只是占位符。
# 任何代码路径都不得写入明文凭据；若需注入，只能从环境变量读。
# =====================================================================

# ---------- PACS（医学影像存档与通信系统） ----------
# AE Title：本地作为 SCU 监听时使用的 Application Entity 名
PACS_AE_TITLE=EXAMPLE_PACS_SCU

# PACS 服务端 host:port（DICOM 协议默认 104；走 TLS 或厂商自定义时改）
PACS_HOST=127.0.0.1
PACS_PORT=11112

# WADO-RS 拉图端点（DICOMweb RESTful 拉片），用于异步取 PNG 字节流
PACS_WADO_URL=http://127.0.0.1:8080/wado-rs

# ---------- RIS（放射信息系统）finding-draft 写回 ----------
# RIS HTTP base URL；finding-draft 端点：POST {RIS_API_URL}/api/v1/studies/{id}/finding-draft
RIS_API_URL=http://127.0.0.1:8081
# RIS Bearer Token（与 header Authorization 一起发送）
RIS_API_TOKEN=replace-me-with-real-ris-token

# ---------- 体检主检系统 summary-ref 写回 ----------
# 体检主检 HTTP base URL；summary-ref 端点：POST {HEALTHCHECK_API_URL}/api/v1/healthcheck/{visitId}/summary-ref
HEALTHCHECK_API_URL=http://127.0.0.1:8082
HEALTHCHECK_API_TOKEN=replace-me-with-real-healthcheck-token

# ---------- ModelGateway（OpenAI-compatible LLM） ----------
# 兼容 OpenAI Chat Completions 协议的端点（本地 vLLM / 医院自建 / 云端统一入口）
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=replace-me-with-real-api-key
# 模型名由网关侧配置决定；这里只声明本系统默认拉哪条
OPENAI_MODEL=medrax-llava-med-7b

# ---------- 业务阈值与路径 ----------
# 阳性分诊阈值：classifier max_prob ≥ 阈值 → positive_flag=true
POSITIVE_THRESHOLD=0.5
# watch folder 兜底通道（PACS 协商失败时轮询 .dcm 文件）
WATCH_FOLDER=/tmp/cxr-watch
